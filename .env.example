# ==============================================================
# BotAI Platform — Environment Configuration
# Every variable is validated at startup (packages/core/config)
# ==============================================================

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Admin Panel / API ---
API_PORT=8080
API_HOST=0.0.0.0
# Public base URL used for webhook setup and OpenAPI servers list
PUBLIC_BASE_URL=http://localhost:8080

# --- PostgreSQL ---
# On VPS with Docker Compose, host = "postgres" (the service name).
DATABASE_URL=postgres://botai:CHANGE_ME_DB_PASSWORD@postgres:5432/botai
DATABASE_POOL_MAX=10
# Password for the postgres container itself (must match DATABASE_URL)
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Telegram Bot ---

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
# 32-byte hex key used to encrypt provider credentials / bot tokens at rest
ENCRYPTION_KEY=
# Secret used to sign admin session tokens
SESSION_SECRET=

# --- First-run bootstrap (used only when no admin exists yet) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Telegram user ID of the platform owner, receives critical notifications
PLATFORM_OWNER_TELEGRAM_ID=

# --- Telegram Bot ---
# Get from @BotFather. Leave empty to run without the bot process.
TELEGRAM_BOT_TOKEN=
# "polling" (development) or "webhook" (production)
TELEGRAM_MODE=polling
# Secret token set on the webhook URL, validated on every webhook request
TELEGRAM_WEBHOOK_SECRET=
# Webhook endpoint path, e.g. /webhooks/telegram
TELEGRAM_WEBHOOK_PATH=/webhooks/telegram

# --- Monitoring ---
# Resource collector interval in ms (VPS dashboard refresh)
METRICS_INTERVAL_MS=2000
