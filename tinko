#!/usr/bin/env bash
# ============================================================
#  Tinko — VPS management CLI
#  یک فرمان برای کنترل کامل پلتفرم روی سرور
#
#  نصب (روی VPS):
#    sudo ln -sf "$(pwd)/tinko" /usr/local/bin/tinko
#  استفاده:
#    tinko setup | status | logs | backup | restore | update | ...
# ============================================================
set -euo pipefail

# ---------- colors ----------
RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; BLUE=$'\e[34m'; CYAN=$'\e[36m'; BOLD=$'\e[1m'; DIM=$'\e[2m'; RESET=$'\e[0m'
ok()   { echo "${GREEN}✔${RESET} $*"; }
warn() { echo "${YELLOW}▲${RESET} $*"; }
err()  { echo "${RED}✖${RESET} $*"; }
info() { echo "${BLUE}➜${RESET} $*"; }

# ---------- paths ----------
# Resolve symlinks (installed as /usr/local/bin/tinko → /opt/tinko/tinko)
SELF="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$SELF" 2>/dev/null || echo "$SELF")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
cd "$SCRIPT_DIR"
ENV_FILE=".env"
COMPOSE="docker compose"
BACKUP_DIR="${BACKUP_DIR:-./backups}"

dc() { $COMPOSE "$@"; }

require_env() {
  if [ ! -f "$ENV_FILE" ]; then
    err "فایل .env پیدا نشد. اول اجرا کن: ${BOLD}tinko setup${RESET}"
    exit 1
  fi
}

rand_hex() { openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | xxd -p -c 64; }
rand_small() { openssl rand -hex 12 2>/dev/null || head -c 12 /dev/urandom | xxd -p -c 24; }

# ============================================================
#  COMMANDS
# ============================================================

cmd_setup() {
  echo "${BOLD}${CYAN}"
  cat <<'ART'
  _____ _   _  ___  ____
 |_   _| \ | |/ _ \/ ___|
   | | |  \| | | | \___ \
   | | | |\  | |_| |___) |
   |_| |_| \_|\___/|____/  🤖
  پلتفرم هوش مصنوعی تلگرام
ART
  echo "${RESET}"
  if [ -f "$ENV_FILE" ]; then
    warn ".env از قبل وجود دارد — ویرایشش کن: nano $ENV_FILE (یا ${BOLD}tinko config${RESET})"
    info "ادامه با نصب…"
  else
    # TINKO_API_PORT=9053 tinko setup  →  panel on port 9053
    local PORT="${TINKO_API_PORT:-${API_PORT:-8080}}"
    info "ساخت .env با مقادیر امن تصادفی… (پورت پنل: ${PORT})"
    local DB_PASS ENC_KEY SESSION_SECRET WH_SECRET ADMIN_PASS
    DB_PASS="$(rand_small)"
    ENC_KEY="$(rand_hex)"; SESSION_SECRET="$(rand_hex)"; WH_SECRET="$(rand_small)"
    ADMIN_PASS="$(rand_small)"
    cat > "$ENV_FILE" <<EOF
# Tinko Platform — generated by 'tinko setup' on $(date '+%F %T')
NODE_ENV=production
LOG_LEVEL=info
API_PORT=${PORT}
PUBLIC_BASE_URL=http://$(hostname -I 2>/dev/null | awk '{print $1}'):${PORT}

DATABASE_URL=postgres://tinko:${DB_PASS}@postgres:5432/tinko
DATABASE_POOL_MAX=10
DATABASE_PASSWORD=${DB_PASS}

REDIS_URL=redis://redis:6379

ENCRYPTION_KEY=${ENC_KEY}
SESSION_SECRET=${SESSION_SECRET}

BOOTSTRAP_ADMIN_EMAIL=admin@tinko.local
BOOTSTRAP_ADMIN_PASSWORD=${ADMIN_PASS}
PLATFORM_OWNER_TELEGRAM_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=${WH_SECRET}
TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
BOT_WEBHOOK_PORT=8081

METRICS_INTERVAL_MS=2000
EOF
    chmod 600 "$ENV_FILE"
    ok ".env ساخته شد (مجوز 600)"
    echo
    echo "${BOLD}اطلاعات ورود اولیه (یادداشت کن!):${RESET}"
    echo "  📧 ایمیل ادمین:   admin@tinko.local"
    echo "  🔑 گذرواژه:       ${ADMIN_PASS}"
    echo
    warn "بعد از اجرای ربات، توکن BotFather را در .env بگذار و ${BOLD}tinko restart${RESET} بزن."
  fi
  info "نصب پیش‌نیازها (docker در صورت نبود)…"
  install_docker_if_missing
  info "بیلد ایمیج‌ها (به‌ترتیب — مناسب VPSهای کم‌رم)…"
  $COMPOSE build api
  $COMPOSE build bot
  $COMPOSE build worker
  info "اجرا…"
  $COMPOSE up -d
  wait_healthy
  final_banner
}

install_docker_if_missing() {
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    ok "Docker از قبل نصب است"
    return
  fi
  info "Docker یافت نشد — نصب خودکار…"
  if command -v apt-get >/dev/null 2>&1; then
    curl -fsSL https://get.docker.com | sh
    systemctl enable --now docker
  elif command -v dnf >/dev/null 2>&1; then
    dnf -y install dnf-plugins-core
    dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
    dnf -y install docker-ce docker-ce-cli containerd.io docker-compose-plugin
    systemctl enable --now docker
  else
    err "توزیع پشتیبانی نشد؛ Docker را دستی نصب کن."; exit 1
  fi
  ok "Docker نصب شد"
}

wait_healthy() {
  info "در انتظار راه‌اندازی سرویس‌ها…"
  local PORT; PORT=$(grep -E '^API_PORT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2); PORT="${PORT:-8080}"
  for i in $(seq 1 60); do
    if curl -fsS "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
      ok "API پاسخ می‌دهد"
      return 0
    fi
    printf "."; sleep 2
  done
  warn "API هنوز بالا نیامده — لاگ‌ها: tinko logs api"
}

final_banner() {
  local PORT; PORT=$(grep -E '^API_PORT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2 || echo 8080)
  echo
  echo "${GREEN}${BOLD}🎉 تینکو آماده است!${RESET}"
  echo "  ${CYAN}پنل مدیریت:${RESET}  http://$(hostname -I 2>/dev/null | awk '{print $1}'):${PORT}"
  echo "  ${CYAN}سلامت سرویس‌ها:${RESET}  tinko status"
  echo "  ${CYAN}همه‌ی فرمان‌ها:${RESET}  tinko help"
}

cmd_status() {
  require_env
  echo "${BOLD}── سرویس‌های Docker ──${RESET}"
  $COMPOSE ps --format "table {{.Service}}\t{{.Status}}" 2>/dev/null || $COMPOSE ps
  echo
  echo "${BOLD}── سلامت پلتفرم ──${RESET}"
  local PORT; PORT=$(grep -E '^API_PORT=' "$ENV_FILE" | cut -d= -f2)
  if curl -fsS "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
    ok "API: آنلاین"
  else
    err "API: پاسخ نمی‌دهد"
  fi
  # DB + Redis via container health
  if [ "$($COMPOSE ps -q postgres 2>/dev/null | xargs docker inspect -f '{{.State.Health.Status}}' 2>/dev/null || echo none)" = "healthy" ]; then ok "PostgreSQL: healthy"; else err "PostgreSQL: not healthy"; fi
  if [ "$($COMPOSE ps -q redis 2>/dev/null | xargs docker inspect -f '{{.State.Health.Status}}' 2>/dev/null || echo none)" = "healthy" ]; then ok "Redis: healthy"; else err "Redis: not healthy"; fi
  echo
  echo "${BOLD}── منابع سرور ──${RESET}"
  local cpu_pct; cpu_pct=$(top -bn1 2>/dev/null | grep -iE 'Cpu\(s\)' | awk '{for(i=1;i<=NF;i++) if ($i ~ /id/) {print $(i-1); exit}}')
  echo "  CPU:    ${cpu_pct:-?}% idle"
  echo "  RAM:    $(free -h 2>/dev/null | awk '/Mem:/{print $3" / "$2}' || echo '?')"
  echo "  DISK:   $(df -h / | awk 'NR==2{print $3" / "$2" ("$5")"}')"
  echo "  Uptime: $(uptime -p 2>/dev/null || echo '?')"
}

cmd_logs() {
  require_env
  local service="${1:-}"
  if [ -n "$service" ]; then $COMPOSE logs -f --tail=200 "$service"
  else $COMPOSE logs -f --tail=100; fi
}

cmd_restart() { require_env; info "ری‌استارت…"; $COMPOSE restart "$@"; ok "انجام شد"; }
cmd_stop()    { require_env; info "خاموش‌کردن…"; $COMPOSE stop "$@"; ok "خاموش شد"; }
cmd_start()   { require_env; info "روشن‌کردن…"; $COMPOSE start "$@" 2>/dev/null || $COMPOSE up -d "$@"; ok "روشن شد"; }

cmd_update() {
  require_env
  info "دریافت کد جدید…"
  git pull --ff-only 2>/dev/null || warn "پوشه‌ی git نیست — فایل‌ها را دستی به‌روزرسانی کن"
  info "بیلد ایمیج‌ها (به‌ترتیب)…"
  $COMPOSE build api && $COMPOSE build bot && $COMPOSE build worker
  info "اجرا…"
  $COMPOSE up -d
  wait_healthy
  ok "به‌روزرسانی کامل شد (مایگریشن‌ها خودکار اعمال شدند)"
}

cmd_backup() {
  require_env
  mkdir -p "$BACKUP_DIR"
  local ts; ts=$(date +%F-%H%M%S)
  local file="$BACKUP_DIR/tinko-backup-$ts.tar.gz"
  info "بکاپ دیتابیس…"
  $COMPOSE exec -T postgres pg_dump -U tinko tinko | gzip > "$BACKUP_DIR/tinko-db-$ts.sql.gz"
  info "بکاپ کانفیگ (.env) رمزنگاری‌شده‌ی ذخیره…"
  cp "$ENV_FILE" "$BACKUP_DIR/.env.$ts.bak" && chmod 600 "$BACKUP_DIR/.env.$ts.bak"
  tar -czf "$file" -C "$BACKUP_DIR" "tinko-db-$ts.sql.gz" ".env.$ts.bak" 2>/dev/null || true
  rm -f "$BACKUP_DIR/tinko-db-$ts.sql.gz" "$BACKUP_DIR/.env.$ts.bak"
  local size; size=$(du -h "$file" | cut -f1)
  ok "بکاپ گرفته شد: ${BOLD}$file${RESET} ($size)"
  # retention: keep last 14
  ls -1t "$BACKUP_DIR"/tinko-backup-*.tar.gz 2>/dev/null | tail -n +15 | xargs -r rm -f
  ok "نگه‌داری ۱۴ بکاپ آخر"
}

cmd_restore() {
  require_env
  local file="${1:-}"
  if [ -z "$file" ]; then
    echo "بکاپ‌های موجود:"; ls -1t "$BACKUP_DIR"/tinko-backup-*.tar.gz 2>/dev/null || err "هیچ بکاپی نیست"
    echo "استفاده: tinko restore <مسیر فایل>"
    exit 1
  fi
  warn "⚠️  دیتابیس فعلی جایگزین می‌شود! ادامه می‌دهیم؟ (yes/no)"
  read -r answer; [ "$answer" = "yes" ] || { info "لغو شد"; return; }
  local tmp; tmp=$(mktemp -d)
  tar -xzf "$file" -C "$tmp"
  $COMPOSE exec -T postgres psql -U tinko -d tinko -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' >/dev/null
  gunzip -c "$tmp"/tinko-db-*.sql.gz | $COMPOSE exec -T postgres psql -U tinko -d tinko >/dev/null
  rm -rf "$tmp"
  $COMPOSE restart api bot worker
  ok "بازیابی انجام شد"
}

cmd_migrate() { require_env; info "اجرای مایگریشن‌ها…"; $COMPOSE exec api node scripts/migrate.js; ok "انجام شد"; }

cmd_shell()   { require_env; local s="${1:-api}"; $COMPOSE exec "$s" sh; }
cmd_psql()    { require_env; $COMPOSE exec postgres psql -U tinko -d tinko; }
cmd_redis()   { require_env; $COMPOSE exec redis redis-cli; }

cmd_admin() {
  require_env
  shift 2>/dev/null || true
  $COMPOSE exec api node scripts/admin.js "$@"
}

cmd_webhook() {
  require_env
  local mode="${1:-info}"
  case "$mode" in
    info)
      local DOMAIN TOKEN
      DOMAIN=$(grep -E '^PUBLIC_BASE_URL=' "$ENV_FILE" | cut -d= -f2-)
      info "Webhook فعلی باید: $DOMAIN/webhooks/telegram"
      $COMPOSE exec api node -e "
        const token = process.env.TELEGRAM_BOT_TOKEN;
        if (!token) { console.log('❌ توکن بات تنظیم نشده'); process.exit(0); }
        fetch('https://api.telegram.org/bot' + token + '/getWebhookInfo').then(r=>r.json()).then(j=>console.log(JSON.stringify(j.result, null, 2)));
      " ;;
    set)
      $COMPOSE exec bot node -e "
        const c = require('node:process').env;
        fetch('https://api.telegram.org/bot' + c.TELEGRAM_BOT_TOKEN + '/setWebhook', {
          method: 'POST', headers: {'content-type': 'application/json'},
          body: JSON.stringify({ url: c.PUBLIC_BASE_URL + c.TELEGRAM_WEBHOOK_PATH, secret_token: c.TELEGRAM_WEBHOOK_SECRET, drop_pending_updates: true })
        }).then(r=>r.json()).then(j=>console.log(j.ok ? '✅ webhook تنظیم شد' : '❌ ' + JSON.stringify(j)));
      " ;;
    *) err "استفاده: tinko webhook [info|set]" ;;
  esac
}

cmd_token() {
  require_env
  local token="${1:-}"
  if [ -z "$token" ]; then err "استفاده: tinko token <BOT_TOKEN از BotFather>"; exit 1; fi
  sed -i.bak "s|^TELEGRAM_BOT_TOKEN=.*|TELEGRAM_BOT_TOKEN=${token}|" "$ENV_FILE" && rm -f "$ENV_FILE.bak"
  ok "توکن ذخیره شد — restart: tinko restart bot"
}

cmd_maintenance() {
  require_env
  local mode="${1:-status}"
  $COMPOSE exec api node -e "
    const pg = require('pg');
    (async () => {
      const p = new pg.Pool({ connectionString: process.env.DATABASE_URL });
      const mode = '${mode}';
      if (mode === 'on' || mode === 'off') {
        await p.query(\"INSERT INTO system_settings (key, value) VALUES ('maintenance_mode', '\{\"enabled\":' + (mode==='on') + '\}') ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value\");
        console.log(mode === 'on' ? '🛠  حالت تعمیرات روشن شد (فقط مالک دسترسی دارد)' : '✅ حالت تعمیرات خاموش شد');
      } else {
        const { rows } = await p.query(\"SELECT value FROM system_settings WHERE key='maintenance_mode'\");
        console.log('وضعیت:', rows[0]?.value?.enabled ? '🛠 روشن' : 'خاموش');
      }
      await p.end();
    })();
  "
}

cmd_ai_kill() {
  require_env
  local mode="${1:-status}"
  $COMPOSE exec api node -e "
    const pg = require('pg');
    (async () => {
      const p = new pg.Pool({ connectionString: process.env.DATABASE_URL });
      const mode = '${mode}';
      if (mode === 'on' || mode === 'off') {
        await p.query(\"UPDATE group_settings SET ai_enabled = false/true\".replace('false/true', mode==='on'?'false':'true'));
        console.log(mode === 'on' ? '🛑 کلید اضطراری AI: خاموش (برای همه گروه‌ها)' : '✅ AI دوباره فعال شد');
      } else {
        const { rows } = await p.query('SELECT count(*)::int n, count(*) FILTER (WHERE ai_enabled)::int on_count FROM group_settings');
        console.log('گروه‌ها:', rows[0].n, '| AI فعال:', rows[0].on_count);
      }
      await p.end();
    })();
  "
}

cmd_diag() {
  require_env
  info "عیب‌یابی کامل…"
  $COMPOSE exec api node -e "
    const pg = require('pg'); const Redis = require('ioredis');
    (async () => {
      const ok = (n, b, extra='') => console.log((b ? '✔ ' : '✖ ') + n + (extra ? ' (' + extra + ')' : ''));
      let p;
      try { p = new pg.Pool({ connectionString: process.env.DATABASE_URL });
        const t0 = Date.now(); await p.query('SELECT 1');
        ok('PostgreSQL', true, Date.now()-t0 + 'ms');
        const { rows: mig } = await p.query('SELECT count(*)::int n FROM schema_migrations');
        ok('مایگریشن‌ها', mig[0].n > 0, mig[0].n + ' اعمال‌شده');
        const { rows: prov } = await p.query('SELECT count(*)::int n FROM providers WHERE status = \\'active\\'');
        ok('تأمین‌کننده‌ی AI', true, prov[0].n + ' فعال');
        const { rows: tok } = await p.query(\"SELECT count(*)::int n FROM providers p WHERE p.status='active' AND EXISTS (SELECT 1 FROM provider_keys k WHERE k.provider_id = p.id AND k.status='active')\");
        if (tok[0].n === 0) console.log('  ⚠️ هیچ کلید API فعالی نیست — از پنل اضافه کن');
      } catch (e) { ok('PostgreSQL', false, e.message); process.exit(0); }
      try { const r = new Redis(process.env.REDIS_URL); await r.ping(); ok('Redis', true); r.disconnect(); } catch (e) { ok('Redis', false, e.message); }
      try {
        const token = process.env.TELEGRAM_BOT_TOKEN;
        if (!token) console.log('▲ Telegram: توکن تنظیم نشده (tinko token <TOKEN>)');
        else { const res = await fetch('https://api.telegram.org/bot' + token + '/getMe').then(r=>r.json());
          ok('Telegram', res.ok, res.result?.username); }
      } catch (e) { ok('Telegram', false, e.message); }
      await p.end();
    })();
  " 2>&1
  echo
  cmd_status | head -20
}

cmd_stats() {
  require_env
  $COMPOSE exec api node -e "
    const pg = require('pg');
    (async () => {
      const p = new pg.Pool({ connectionString: process.env.DATABASE_URL });
      const one = async (label, q) => { const { rows } = await p.query(q); console.log(label.padEnd(24), rows[0].n); };
      console.log('── آمار پلتفرم تینکو ──');
      await one('👥 گروه‌ها:', 'SELECT count(*)::int n FROM telegram_groups');
      await one('🙋 کاربران:', 'SELECT count(*)::int n FROM telegram_users');
      await one('💬 پیام‌های ۲۴ ساعت:', 'SELECT count(*)::int n FROM messages WHERE created_at > now() - interval \\'24 hours\\'');
      await one('🤖 درخواست AI (کل):', 'SELECT count(*)::int n FROM usage_records');
      await one('🎫 توکن مصرفی (کل):', 'SELECT COALESCE(sum(tokens_in+tokens_out),0)::bigint::text n FROM usage_records');
      await one('💰 هزینه (کل):', 'SELECT \\'\\$\\' || round(sum(cost)::numeric, 2)::text n FROM usage_records');
      await one('🧠 حافظه‌های فعال:', 'SELECT count(*)::int n FROM memories WHERE status = \\'active\\'');
      await one('🛡 رخدادهای مدریشن:', 'SELECT count(*)::int n FROM moderation_events');
      const { rows } = await p.query(\"SELECT value FROM system_settings WHERE key='bot_identity'\");
      console.log('🏷  اسم ربات:', rows[0]?.value?.name ?? 'تینکو');
      await p.end();
    })();
  " 2>&1
}

cmd_cleanup() {
  require_env
  info "پاکسازی images بلااستفاده Docker…"
  docker image prune -f >/dev/null 2>&1 && ok "انجام شد"
  info "پاکسازی نگهداری‌شده‌های دیتابیس (لاگ/متریک قدیمی)…"
  $COMPOSE exec worker node -e "import('./apps/worker/src/jobs/maintenance.js').then(async m => { const pg = require('pg'); const p = new pg.Pool({connectionString: process.env.DATABASE_URL}); await p.query(\"DELETE FROM resource_metrics WHERE captured_at < now() - interval '1 hour'\"); await p.query(\"DELETE FROM provider_health_checks WHERE checked_at < now() - interval '14 days'\"); console.log('✔ db cleaned'); await p.end(); })" 2>/dev/null || warn "worker در دسترس نیست — بعداً خودکار انجام می‌شود"
}

cmd_help() {
  echo "${BOLD}${CYAN}تینکو — مدیریت پلتفرم${RESET}"
  cat <<EOF
${BOLD}نصب و راه‌اندازی:${RESET}
  tinko setup            نصب کامل خودکار (پیش‌نیازها + .env + بیلد + اجرا)
  tinko token <TOKEN>    ثبت توکن BotFather
  tinko update           به‌روزرسانی از گیت + بیلد + اجرای مجدد
  tinko webhook [set]    تنظیم/بررسی وبهوک تلگرام

${BOLD}وضعیت و عیب‌یابی:${RESET}
  tinko status           وضعیت سرویس‌ها + منابع سرور
  tinko diag             عیب‌یابی کامل (DB/Redis/Telegram/AI)
  tinko stats            آمار پلتفرم (گروه/کاربر/پیام/هزینه/حافظه)
  tinko logs [service]   لاگ زنده (api | bot | worker | postgres | redis)
  tinko cleanup          پاکسازی images و داده‌های قدیمی

${BOLD}کنترل سرویس‌ها:${RESET}
  tinko start [service]  روشن‌کردن
  tinko stop [service]   خاموش‌کردن
  tinko restart [service] ری‌استارت

${BOLD}امنیت و اضطراری:${RESET}
  tinko backup           بکاپ کامل (دیتابیس + کانفیگ، نگه‌داری ۱۴ نسخه)
  tinko restore <file>   بازیابی از بکاپ
  tinko maintenance on|off  حالت تعمیرات (بات فقط به مالک جواب می‌دهد)
  tinko ai-kill on|off   کلید اضطراری AI برای همه گروه‌ها

${BOLD}مدیریت ادمین‌ها:${RESET}
  tinko admin list       فهرست ادمین‌های پنل
  tinko admin create <email> <pass> [name]
  tinko admin reset <email> <pass>     ریست گذرواژه + خروج همه‌ی نشست‌ها
  tinko admin promote <email>          ارتقا به super_admin
  tinko admin disable <email>

${BOLD}ابزارها:${RESET}
  tinko migrate          اجرای دستی مایگریشن‌ها
  tinko shell [service]  شل داخل کانتینر (api | worker | bot | postgres | redis)
  tinko psql             کنسول PostgreSQL
  tinko redis            کنسول Redis
EOF
}

# ============================================================
#  ROUTER
# ============================================================
case "${1:-help}" in
  setup)          cmd_setup ;;
  status)         cmd_status ;;
  logs)           shift; cmd_logs "$@" ;;
  restart)        shift; cmd_restart "$@" ;;
  stop)           shift; cmd_stop "$@" ;;
  start)          shift; cmd_start "$@" ;;
  update)         cmd_update ;;
  backup)         cmd_backup ;;
  restore)        shift; cmd_restore "$@" ;;
  migrate)        cmd_migrate ;;
